# ============================================================
# .gitignore — ігноровані файли репозиторію
# ============================================================
# секрети
.env
*.env

# персональні дані
fish/fish_variables
quickshell/data/calendar-tasks.json
quickshell/data/launcher-usage.json

# шпалери (залишаємо лише wp1.jpg як заглушку)
quickshell/wp/*
!quickshell/wp/wp1.jpg
*.bak
quickshell/scripts/.genshin_requests.log
quickshell/scripts/.genshin_state.json
quickshell/scripts/__pycache__/

# python-кеш тестів
tests/__pycache__/
tests/python/__pycache__/
quickshell/services/__pycache__/

# локальні skills агентів
quickshell/.opencode/skills/

# рантайм-артефакт: симлінк у vfs quickshell, змінюється при кожному старті
quickshell/.qmlls.ini

# згенеровані персональні налаштування
quickshell/Palette.js
quickshell/data/control-state.json
quickshell/data/last-shot.txt

# дефолтні config.json/palette.json трекаються у git: свіжому клону
# вони потрібні, щоб бар рендерився з сепараторами і робочою палітрою
