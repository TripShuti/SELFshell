#!/usr/bin/env bash
# ============================================================
# selfshell — CLI для керування SELFshell: IPC-виклики,
# діагностика (doctor), версія, оновлення, перезапуск
# ============================================================
set -uo pipefail

# --- Резолюція шляхів: працює і з клону репо, і з ~/.config/quickshell ---
SCRIPT_PATH="$(readlink -f "${BASH_SOURCE[0]}")"
SCRIPT_DIR="$(dirname "$SCRIPT_PATH")"
QS_CONFIG_DIR="$(dirname "$SCRIPT_DIR")"
REPO_URL="https://github.com/TripShuti/selfshell"

info()  { echo -e "\033[1;36m[i]\033[0m $*"; }
ok()    { echo -e "\033[1;32m[o]\033[0m $*"; }
warn()  { echo -e "\033[1;33m[!]\033[0m $*"; }
error() { echo -e "\033[1;31m[x]\033[0m $*" >&2; }

usage() {
  cat <<'EOF'
selfshell — CLI SELFshell

Використання:
  selfshell <команда> [аргументи...]

Команди:
  help                           Показати цю довідку
  version                        Версія SELFshell
  ipc call <target> <fn> [args]  Викликати IPC-функцію quickshell
  lock                           Заблокувати екран
  toggle-lock                    Перемкнути блокування
  launcher                       Відкрити/закрити лаунчер
  settings                       Відкрити/закрити налаштування бару
  palette-reload                 Перечитати палітру зі шпалери
  doctor                         Діагностика системи
  reload                         Перезапустити quickshell
  update                         Оновити конфіг (git pull або архів) і перезапустити шелл
  list                           Список запущених інстансів quickshell
EOF
}

version() {
  local v=""
  if [ -f "$QS_CONFIG_DIR/VERSION" ]; then
    v="$(cat "$QS_CONFIG_DIR/VERSION")"
  fi
  if git -C "$QS_CONFIG_DIR" rev-parse --is-inside-work-tree &>/dev/null; then
    local tag
    tag="$(git -C "$QS_CONFIG_DIR" describe --tags --exact-match 2>/dev/null)"
    [ -n "$tag" ] && v="$tag"
    echo "selfshell ${v:-$(git -C "$QS_CONFIG_DIR" rev-parse --short HEAD)} ($QS_CONFIG_DIR)"
    return
  fi
  echo "selfshell ${v:-unknown} ($QS_CONFIG_DIR)"
}

# --- Виклик IPC: приймає "call" або одразу target ---
ipc() {
  if [ "${1:-}" = "call" ]; then shift; fi
  if [ "$#" -lt 2 ]; then
    error "Використання: selfshell ipc call <target> <function> [args...]"
    exit 1
  fi
  local target="$1"; shift
  local fn="$1"; shift
  qs ipc call "$target" "$fn" "$@"
}

lock()        { ipc lockscreen lock; }
toggle_lock() { ipc lockscreen toggle; }
launcher()    { ipc launcher toggle; }
settings()    { ipc settings toggle; }
palette()     { ipc palette-reload reload; }

# quickshell у daemonize-режимі перейменовує comm на "qs",
# тому перевірка лише по "quickshell" дає хибний результат
qs_running() {
  pgrep -x quickshell &>/dev/null || pgrep -x qs &>/dev/null
}

# Перезапуск quickshell: kill + новий інстанс у daemonize-режимі
reload() {
  if ! pgrep -x Hyprland &>/dev/null; then
    error "Hyprland не запущено — quickshell перезапускати нікуди."
    exit 1
  fi
  if qs_running; then
    info "Зупиняю quickshell..."
    qs kill &>/dev/null || true
    sleep 1
    if qs_running; then
      # qs kill може не спрацювати — запасний варіант
      pkill -x qs 2>/dev/null
      pkill -x quickshell 2>/dev/null
      sleep 1
    fi
  fi
  info "Запускаю quickshell..."
  setsid qs -d &>/dev/null &
  sleep 1
  if qs_running; then
    ok "quickshell працює."
  else
    error "quickshell не піднявся. Дивіться: qs log"
    exit 1
  fi
}

# Оновлення конфігу. Git-клон → git pull; конфіг від install.sh (cp, без .git)
# → завантажуємо архів з GitHub і rsync-имо quickshell/. Локальні файли
# (LOCAL_FILES — ті самі, що в .gitignore репозиторію) не перезаписуються.
update() {
  if git -C "$QS_CONFIG_DIR" rev-parse --is-inside-work-tree &>/dev/null; then
    info "Оновлюю $QS_CONFIG_DIR (git pull)..."
    git -C "$QS_CONFIG_DIR" pull --ff-only || { error "git pull не вдався."; exit 1; }
  else
    update_from_archive
  fi
  reload
}

# Персональні/згенеровані файли, які не чіпаємо при оновленні з архіву
LOCAL_FILES=(
  data/config.json          # налаштування з Settings
  data/palette.json         # генерується update-palette
  data/calendar-tasks.json  # задачі календаря
  data/control-state.json   # стан центру керування
  data/launcher-usage.json  # статистика лаунчера
  scripts/.env              # секрети (HoYoLAB)
  scripts/.genshin_state.json
  scripts/.genshin_requests.log
  scripts/__pycache__/
  wp/                       # персональні шпалери + current.jpg
  .qmlls.ini
  .opencode/
  Palette.js
)

update_from_archive() {
  command -v curl &>/dev/null || { error "curl не знайдено (пакет: curl)."; exit 1; }
  local tmp="$(mktemp -d)"
  local url="$REPO_URL/archive/refs/heads/main.tar.gz"
  info "Завантажую архів: $url"
  if ! curl -fsSL "$url" -o "$tmp/selfshell.tar.gz"; then
    rm -rf "$tmp"
    error "Не вдалося завантажити архів — перевірте інтернет і назву репозиторію."
    exit 1
  fi
  # --strip-components=1: ім'я кореневої теки архіву не фіксоване
  if ! tar -xzf "$tmp/selfshell.tar.gz" -C "$tmp" --strip-components=1; then
    rm -rf "$tmp"
    error "Архів пошкоджено — розпакування не вдалося."
    exit 1
  fi
  local src="$tmp/quickshell"
  if [ ! -d "$src" ]; then
    rm -rf "$tmp"
    error "Архів пошкоджено — quickshell/ не знайдено."
    exit 1
  fi
  # Копіюємо через tar: виключення не пропустять локальні файли
  local excludes=()
  for f in "${LOCAL_FILES[@]}"; do excludes+=(--exclude="*/$f"); done
  info "Розпаковую в $QS_CONFIG_DIR (локальні файли зберігаються)..."
  if ! tar -C "$src" -cf - . | tar -C "$QS_CONFIG_DIR" -xf - "${excludes[@]}"; then
    rm -rf "$tmp"
    error "Оновлення не вдалося."
    exit 1
  fi
  rm -rf "$tmp"
  ok "Конфіг оновлено."
}

doctor() {
  local problems=0
  # --preboot: інсталер до першого входу в Hyprland (пропуск перевірки сесії)
  local preboot=false
  [ "${1:-}" = "--preboot" ] && preboot=true

  echo
  echo "== Залежності (обов'язкові) =="
  local deps=(hyprland qs kitty fish starship yazi fastfetch playerctl
              cava matugen hyprsunset awww grim slurp wl-copy socat
              yt-dlp notify-send ddcutil upower uwsm)
  for dep in "${deps[@]}"; do
    if command -v "$dep" &>/dev/null; then
      ok "$dep"
    else
      error "$dep — не знайдено"
      problems=$((problems + 1))
    fi
  done
  # qt6-5compat — модуль Qt5Compat.GraphicalEffects, без нього шелл не стартує
  if [ -d /usr/lib/qt6/qml/Qt5Compat/GraphicalEffects ]; then
    ok "qt6-5compat (Qt5Compat.GraphicalEffects)"
  else
    error "qt6-5compat — модуль Qt5Compat.GraphicalEffects не знайдено"
    problems=$((problems + 1))
  fi

  echo
  echo "== Python-модулі (для скриптів) =="
  for mod in gi dbus requests dotenv; do
    if python3 -c "import $mod" 2>/dev/null; then
      ok "python: $mod"
    else
      warn "python: $mod — відсутній (потрібен для відповідного скрипта)"
    fi
  done

  if ! $preboot; then
    echo
    echo "== Сесія =="
    if pgrep -x Hyprland &>/dev/null; then
      ok "Hyprland запущено"
    else
      error "Hyprland не запущено"
      problems=$((problems + 1))
    fi
    if qs_running; then
      ok "quickshell запущено"
    else
      error "quickshell не запущено"
      problems=$((problems + 1))
    fi
  fi

  echo
  echo "== Конфігурація ($QS_CONFIG_DIR) =="
  if [ -f "$QS_CONFIG_DIR/shell.qml" ]; then
    ok "shell.qml"
  else
    error "shell.qml відсутній"
    problems=$((problems + 1))
  fi
  [ -f "$QS_CONFIG_DIR/Bar.qml" ] && ok "Bar.qml" || { error "Bar.qml відсутній"; problems=$((problems + 1)); }
  if [ -f "$QS_CONFIG_DIR/data/config.json" ]; then
    if python3 -m json.tool "$QS_CONFIG_DIR/data/config.json" >/dev/null 2>&1; then
      ok "data/config.json (валідний JSON)"
    else
      error "data/config.json — пошкоджений JSON"
      problems=$((problems + 1))
    fi
  else
    warn "data/config.json відсутній — будуть дефолтні налаштування"
  fi
  if [ -f "$QS_CONFIG_DIR/scripts/.env" ]; then
    if grep -qi "your_" "$QS_CONFIG_DIR/scripts/.env"; then
      warn "scripts/.env містить значення-заглушки (геншин-віджет не працюватиме)"
    else
      ok "scripts/.env"
    fi
  else
    warn "scripts/.env відсутній — скопіюйте з .env.example"
  fi
  if [ -f "$QS_CONFIG_DIR/wp/current.jpg" ]; then
    ok "wp/current.jpg (фон блокування)"
  else
    warn "wp/current.jpg відсутній — буде заглушка wp1.jpg (налаштуйте: selfshell palette-reload)"
  fi

  echo
  echo "== Hyprland конфіг =="
  if [ -f "$HOME/.config/hypr/hyprland.lua" ]; then
    ok "hyprland.lua"
    if [ -f "$HOME/.config/hypr/env.json" ]; then
      if python3 -m json.tool "$HOME/.config/hypr/env.json" >/dev/null 2>&1; then
        ok "hypr/env.json (валідний JSON)"
      else
        error "hypr/env.json — пошкоджений JSON"
        problems=$((problems + 1))
      fi
    else
      warn "hypr/env.json відсутній — використовуються дефолти (kitty, chromium...)"
    fi
    if [ -f "$HOME/.config/hypr/modules/json.lua" ]; then
      ok "modules/json.lua"
    else
      error "modules/json.lua відсутній — hyprland.lua не завантажиться"
      problems=$((problems + 1))
    fi
  fi

  echo
  echo "== Сервіси =="
  if systemctl is-active --quiet NetworkManager 2>/dev/null; then
    ok "NetworkManager активний"
  else
    error "NetworkManager не активний"
    problems=$((problems + 1))
  fi
  if systemctl is-active --quiet bluetooth 2>/dev/null; then
    ok "bluetooth активний"
  else
    warn "bluetooth не активний (може бути відсутній адаптер)"
  fi
  if systemctl --user is-active --quiet qs-bt-agent 2>/dev/null; then
    ok "qs-bt-agent (user-сервіс) активний"
  else
    warn "qs-bt-agent (user-сервіс) не активний — пейринг BT через UI недоступний"
  fi

  echo
  echo "== Обладнання =="
  if command -v ddcutil &>/dev/null; then
    if timeout 6 ddcutil detect &>/dev/null; then
      ok "ddcutil виявляє монітори"
    else
      warn "ddcutil не бачить моніторів (i2c-права/udev — яскравість буде недоступна)"
    fi
  else
    warn "ddcutil не встановлено — яскравість через DDC недоступна"
  fi

  echo
  if [ "$problems" -gt 0 ]; then
    error "Знайдено $problems критичних проблем."
    exit 1
  fi
  ok "Все гаразд."
}

case "${1:-help}" in
  help|-h|--help) usage ;;
  version|-V|--version) version ;;
  ipc) shift; ipc "$@" ;;
  lock) lock ;;
  toggle-lock) toggle_lock ;;
  launcher) launcher ;;
  settings) settings ;;
  palette-reload) palette ;;
  doctor) shift; doctor "$@" ;;
  reload) reload ;;
  update) update ;;
  list) qs list ;;
  *) error "Невідома команда: ${1:-}"; usage; exit 1 ;;
esac
