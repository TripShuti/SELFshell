# ============================================================
# qs-bt-agent.service — systemd unit для BlueZ pairing agent
# ============================================================
[Unit]
Description=BlueZ pairing agent for SELFshell (NoInputNoOutput)
# User-менеджер не бачить system-сервіси: Requires/After на
# bluetooth.service тут безглузді і БЛОКУЮТЬ рестарт
# ("Unit bluetooth.service not found"). Відсутність bluez покривається
# DBus-помилкою + Restart=on-failure.

[Service]
ExecStart=/usr/bin/python3 %h/.config/quickshell/services/qs-bt-agent
Restart=on-failure
RestartSec=2

[Install]
WantedBy=default.target
